# Resend (https://resend.com/api-keys) — crea una API key gratis y pégala aquí.
# En Vercel, define estas variables en: Project Settings > Environment Variables.
RESEND_API_KEY=

# Correo verificado en Resend desde el que se envían los mensajes.
# Por defecto Resend permite onboarding@resend.dev para pruebas.
FROM_EMAIL=onboarding@resend.dev

# Correo destino donde llegarán las consultas del formulario.
CONTACT_EMAIL=rolonkevin016@gmail.com
